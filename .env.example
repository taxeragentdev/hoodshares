# Local `next dev` can skip this and write to data/players.json.
# Vercel Neon sets POSTGRES_URL automatically. DATABASE_URL also works.

DATABASE_URL=
POSTGRES_URL=
HOODSHARES_SECRET=
HOODSHARES_CRON_SECRET=

# Public OpenSea links (not secrets). Leave blank to use the HoodPass collection.
NEXT_PUBLIC_OPENSEA_MINT_URL=https://opensea.io/collection/hoodpass-491043604/overview
NEXT_PUBLIC_OPENSEA_COLLECTION_URL=https://opensea.io/collection/hoodpass-491043604
# OpenSea HoodPass contract (collection Details). Public. Not a secret.
NEXT_PUBLIC_HOODPASS_CONTRACT=0xE2C05B91f0936D09d84D36eDbe8B513235A1D2d6
NEXT_PUBLIC_PACK_TOKEN_ADDRESS_MAINNET=0xe5A8Fe54e0D367DB85Ebb1B9245BE8cB1EfBE7df
# Wallet that receives pack (50,000 SOOD) and round (5,000 SOOD) payments.
NEXT_PUBLIC_SOOD_TREASURY=0x579c3812621b9503AF46B56c579C4D92850a6DC0
NEXT_PUBLIC_WALLETCONNECT_ID=
